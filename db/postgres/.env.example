# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 git에서 제외됩니다.
POSTGRES_USER=app
POSTGRES_PASSWORD=        # openssl rand -hex 24
# 맨 처음 데이터 폴더를 만들 때 생기는 기본 DB 이름이고, 헬스체크가 접속하는 DB이기도 합니다.
# 특정 서비스 DB 이름이 아니라 postgres 를 권장합니다. (서비스 DB는 각 서비스의 init.sql 이 만듭니다)
POSTGRES_DB=postgres
# DB 포트(5432)를 열 홈서버의 IP. 0.0.0.0 금지
DB_BIND_IP=
# (선택) 데이터 폴더. 비워 두면 이 폴더의 ./data/pg 입니다.
# 저장소 밖 절대 경로를 쓰면 `git clean -fdx` 로 데이터가 지워질 위험이 없습니다.
# PG_DATA_DIR=/srv/postgres/data
